{
  "name": "metra",
  "private": true,
  "version": "0.1.38",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "eyotang",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "vite": "vite",
    "build": "tauri build",
    "build:macos-universal": "node scripts/build-macos-universal.mjs",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "check": "tsc --noEmit",
    "verify:color": "node scripts/verify-color-picker.mjs",
    "verify:cursor-login": "node scripts/verify-cursor-login.mjs",
    "verify:cursor-ultra": "node scripts/verify-cursor-ultra.mjs",
    "verify:provider-navigation": "node --experimental-strip-types scripts/verify-provider-navigation.mjs",
    "verify:bubble-snap": "node --experimental-strip-types scripts/verify-bubble-snap.mjs",
    "verify:i18n": "node --experimental-strip-types scripts/verify-i18n.mjs",
    "verify:macos-build": "node scripts/verify-macos-universal-build.mjs",
    "verify:package-manager": "node scripts/verify-package-manager.mjs",
    "verify:visibility": "node scripts/verify-bubble-visibility.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
